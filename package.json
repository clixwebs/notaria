{
  "name": "notaria-os",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {"node": "24.x"},
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test --config playwright.phase6.config.ts",
    "test": "tsx --test tests/domain.test.ts tests/platform.test.ts tests/person-lookup.test.ts tests/cases.test.ts tests/finance.test.ts tests/tariffs.test.ts tests/fiscal.test.ts tests/templates.test.ts tests/procedures.test.ts tests/compliance.test.ts tests/integrations.test.ts",
    "backup:local": "tsx scripts/backup-local.ts",
    "restore:local": "tsx scripts/restore-local.ts",
    "test:procedure": "playwright test --config playwright.procedure-focused.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@phosphor-icons/react": "2.1.10",
    "better-auth": "^1.7.14",
    "kysely": "^0.29.7",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsqr": "1.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
